# Application environment
SPRING_PROFILES_ACTIVE="dev"

# Database configuration
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="database"
POSTGRES_SCHEMA="public"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"

# Authentication
ACCESS_TOKEN_SECRET="replace-with-a-base64-encoded-secret"
REFRESH_COOKIE_SECURE="false"
REFRESH_SESSION_CLEANUP_INTERVAL="1h"
REFRESH_SESSION_CLEANUP_INITIAL_DELAY="1h"

# Authentication rate limits
AUTH_RATE_LIMIT_WINDOW="1m"
AUTH_RATE_LIMIT_REGISTER_REQUESTS="5"
AUTH_RATE_LIMIT_LOGIN_REQUESTS="10"
AUTH_RATE_LIMIT_REFRESH_REQUESTS="30"

# Browser access
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Logging
LOG_LEVEL="INFO"
