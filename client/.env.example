# Standalone Next.js development environment
# Copy this file to .env.local in the client directory.
# Never commit .env.local. Real process environment variables override it.

# Server URL used by Server Actions. Keep localhost for standalone development.
# Compose uses the internal server service name instead.
API_URL="http://localhost:8080"

# Public URL of this client. It is used for canonical, Open Graph, and Twitter
# metadata. Use an absolute origin without a trailing slash and rebuild after
# changing it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
