# Standalone Delvex server environment
# Copy this file to server/.env for local JVM or IDE development.
# Never commit server/.env or reuse these local credentials in production.
# Spring-Dotenv parses optional quotes. Real environment variables take priority.

# Spring profile
# Use dev for local HTTP. Production deployments should provide prod through
# the real environment instead of relying on this file.
SPRING_PROFILES_ACTIVE="dev"

# PostgreSQL connection from the host
# localhost is correct when PostgreSQL is published by Docker Compose.
# Keep database, user, and password equal to the root .env values.
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="delvex"
POSTGRES_SCHEMA="public"
POSTGRES_USER="delvex"
POSTGRES_PASSWORD="local-password"

# Redis connection from the host
# Start the Redis service from the root Compose stack.
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_CONNECT_TIMEOUT="2s"
REDIS_TIMEOUT="2s"

# Authentication
# Required Base64 value containing at least 32 decoded bytes.
# Generate one with: openssl rand -base64 32
ACCESS_TOKEN_SECRET="replace-with-a-base64-encoded-secret"

# Refresh-session cleanup
# Supported duration examples: 30m, 1h, 1d.
REFRESH_SESSION_CLEANUP_INTERVAL="1h"
REFRESH_SESSION_CLEANUP_INITIAL_DELAY="1h"

# Authentication rate limiting
# Counters are shared through Redis across all server instances and expire at
# the end of each fixed window.
AUTH_RATE_LIMIT_WINDOW="1m"
AUTH_RATE_LIMIT_REGISTER_REQUESTS="5"
AUTH_RATE_LIMIT_LOGIN_REQUESTS="10"
AUTH_RATE_LIMIT_REFRESH_REQUESTS="30"

# Trusted reverse proxies
# Comma-separated IPv4/IPv6 CIDRs allowed to provide Forwarded or
# X-Forwarded-For. Leave empty for direct local connections.
# Never trust 0.0.0.0/0 or ::/0 when the server is directly reachable.
AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS=""

# Browser access
# Comma-separated exact origins without paths or trailing slashes.
# Production requires explicit HTTPS origins.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Logging
# Controls com.delvex.server. Common values: TRACE, DEBUG, INFO, WARN, ERROR.
LOG_LEVEL="INFO"

# REFRESH_COOKIE_SECURE is intentionally not configurable.
# Cookies are Secure by default/prod and disabled only by the dev profile.

