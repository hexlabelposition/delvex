# Standalone Next.js development environment
# Copy this file to .env.local in the client directory.
# Never commit .env.local. Real process environment variables override it.

# Public server URL used by browser requests.
# NEXT_PUBLIC_ values are visible to every user and must never contain secrets.
# Use a URL reachable from the browser, without a trailing slash.
# Local development and the default Compose stack expose the API on port 8080.
# Next.js embeds this value during "bun run build"; rebuild after changing it.
NEXT_PUBLIC_API_URL="http://localhost:8080"
