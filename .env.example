# Application environment
# Set explicitly to dev locally or prod in deployment
SPRING_PROFILES_ACTIVE=""

# Database configuration
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="database"
POSTGRES_SCHEMA="public"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"

# Authentication
ACCESS_TOKEN_SECRET="replace-with-a-base64-encoded-secret"
REFRESH_SESSION_CLEANUP_INTERVAL="1h"
REFRESH_SESSION_CLEANUP_INITIAL_DELAY="1h"

# Authentication rate limits
AUTH_RATE_LIMIT_WINDOW="1m"
AUTH_RATE_LIMIT_REGISTER_REQUESTS="5"
AUTH_RATE_LIMIT_LOGIN_REQUESTS="10"
AUTH_RATE_LIMIT_REFRESH_REQUESTS="30"
# Comma-separated CIDRs of proxies allowed to supply client IP headers
AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS=""

# Browser access
# Production requires one or more comma-separated HTTPS origins
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Logging
LOG_LEVEL="INFO"
