# Docker Compose environment
# Copy this file to .env in the repository root.
# Never commit .env or reuse these placeholder credentials in a deployment.
# Shell environment variables override values from this file.

# PostgreSQL container
# These values initialize PostgreSQL and are also passed to the server.
# When running the server on the host, keep them equal to server/.env.
POSTGRES_DB="delvex"
POSTGRES_USER="delvex"
POSTGRES_PASSWORD="local-password"

# Redis rate-limit store
# Counters are intentionally ephemeral and expire automatically.
REDIS_CONNECT_TIMEOUT="2s"
REDIS_TIMEOUT="2s"

# Server container
# Required explicitly. Use dev for local HTTP or prod for deployment.
# Never activate dev and prod together.
SPRING_PROFILES_ACTIVE="dev"

# Compose connects the server to postgres:5432 internally.
# Only the schema remains configurable from the root environment.
POSTGRES_SCHEMA="public"

# Required Base64 value containing at least 32 decoded bytes.
# Generate one with: openssl rand -base64 32
ACCESS_TOKEN_SECRET="replace-with-a-base64-encoded-secret"

# Refresh-session cleanup
# Spring duration syntax is supported, for example 30m, 1h, or 1d.
REFRESH_SESSION_CLEANUP_INTERVAL="1h"
REFRESH_SESSION_CLEANUP_INITIAL_DELAY="1h"

# Authentication rate limiting
AUTH_RATE_LIMIT_WINDOW="1m"
AUTH_RATE_LIMIT_REGISTER_REQUESTS="5"
AUTH_RATE_LIMIT_LOGIN_REQUESTS="10"
AUTH_RATE_LIMIT_REFRESH_REQUESTS="30"
AUTH_RATE_LIMIT_FORGOT_PASSWORD_REQUESTS="5"
AUTH_RATE_LIMIT_RESET_PASSWORD_REQUESTS="10"

# Comma-separated CIDRs of reverse proxies trusted to provide Forwarded or
# X-Forwarded-For. Leave empty for direct local connections.
AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS=""

# Password recovery
# Compose derives the reset page from NEXT_PUBLIC_SITE_URL below and captures
# outgoing development email in Mailpit at http://localhost:8025.
PASSWORD_RESET_TOKEN_TTL="30m"
PASSWORD_RESET_CLEANUP_INTERVAL="1h"
PASSWORD_RESET_CLEANUP_INITIAL_DELAY="1h"
MAIL_FROM="no-reply@delvex.local"

# Production SMTP example (Resend)
# Set these variables on the deployed server service, not in a committed file.
# PASSWORD_RESET_CLIENT_URL must be the public client reset page.
# Resend uses the literal username "resend" and an API key as the password.
# MAIL_FROM must use a sender domain verified in the Resend dashboard.
# PASSWORD_RESET_CLIENT_URL="https://app.example.com/reset-password"
# MAIL_HOST="smtp.resend.com"
# MAIL_PORT="587"
# MAIL_USERNAME="resend"
# MAIL_PASSWORD="re_replace-with-a-resend-api-key"
# MAIL_FROM="no-reply@example.com"
# MAIL_SMTP_AUTH="true"
# MAIL_SMTP_STARTTLS="true"

# Browser access
# Use exact origins without paths or trailing slashes.
# Production accepts only explicitly configured HTTPS origins.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Server logging
# Common values: TRACE, DEBUG, INFO, WARN, ERROR.
LOG_LEVEL="INFO"

# Client container
# Next.js runtime mode. Keep production: the image contains a production
# build, so development would only disable optimizations without enabling
# hot reload. Use "bun run dev" in the client directory for that instead.
NODE_ENV="production"

# Server URL used by Next.js Server Actions inside the Compose network.
# This value is never exposed to browsers.
API_URL="http://server:8080"

# Public API URL embedded into the browser bundle during the image build.
# This value is visible to users and must never contain secrets.
# Use the browser-reachable address, not the Docker service name "server".
# Rebuild the client image after changing it.
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Public client URL embedded into metadata during the image build. Use an
# absolute origin without a trailing slash and rebuild after changing it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
