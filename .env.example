# Docker Compose environment
# Copy this file to .env in the repository root.
# Never commit .env or reuse these placeholder credentials in a deployment.
# Shell environment variables override values from this file.

# PostgreSQL container
# These values initialize PostgreSQL and are also passed to the server.
# When running the server on the host, keep them equal to server/.env.
POSTGRES_DB="delvex"
POSTGRES_USER="delvex"
POSTGRES_PASSWORD="local-password"

# Server container
# Required explicitly. Use dev for local HTTP or prod for deployment.
# Never activate dev and prod together.
SPRING_PROFILES_ACTIVE="dev"

# Compose connects the server to postgres:5432 internally.
# Only the schema remains configurable from the root environment.
POSTGRES_SCHEMA="public"

# Required Base64 value containing at least 32 decoded bytes.
# Generate one with: openssl rand -base64 32
ACCESS_TOKEN_SECRET="replace-with-a-base64-encoded-secret"

# Refresh-session cleanup
# Spring duration syntax is supported, for example 30m, 1h, or 1d.
REFRESH_SESSION_CLEANUP_INTERVAL="1h"
REFRESH_SESSION_CLEANUP_INITIAL_DELAY="1h"

# Authentication rate limiting
AUTH_RATE_LIMIT_WINDOW="1m"
AUTH_RATE_LIMIT_REGISTER_REQUESTS="5"
AUTH_RATE_LIMIT_LOGIN_REQUESTS="10"
AUTH_RATE_LIMIT_REFRESH_REQUESTS="30"

# Comma-separated CIDRs of reverse proxies trusted to provide Forwarded or
# X-Forwarded-For. Leave empty for direct local connections.
AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS=""

# Browser access
# Use exact origins without paths or trailing slashes.
# Production accepts only explicitly configured HTTPS origins.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Server logging
# Common values: TRACE, DEBUG, INFO, WARN, ERROR.
LOG_LEVEL="INFO"

# Client container
# Client-specific variables will be added here when the client joins Compose.
